# GEMINI_API_KEY: required. Read ONLY by the Express server (server/index.ts)
# from the environment or from .env.local / .env. It is never sent to the browser.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional: Gemini model name (default: gemini-3.1-pro-preview)
# GEMINI_MODEL="gemini-3.1-pro-preview"

# Optional: port of the API server (default 8787). The Vite dev server proxies /api to it.
# PORT=8787
